<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="MAIN_Line">
    <Declaration><![CDATA[PROGRAM MAIN_Line
VAR
    conveyors : ARRAY[1..3] OF FB_Conveyor;
    configured : BOOL;
    i : DINT;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[FOR i := LOWER_BOUND(conveyors, 1) TO UPPER_BOUND(conveyors, 1) DO
    IF NOT configured THEN
        (* Bind once. Later calls preserve Python detach/rebind operations. *)
        conveyors[i](config := GVL_Line.config);
    ELSE
        conveyors[i]();
    END_IF;
    GVL_Line.running[i] := conveyors[i].running;
    GVL_Line.actualSpeed[i] := conveyors[i].actualSpeed;
    GVL_Line.missingConfig[i] := conveyors[i].missingConfig;
END_FOR;
configured := TRUE;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
