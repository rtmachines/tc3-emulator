<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="MAIN_Line">
    <Declaration><![CDATA[PROGRAM MAIN_Line
VAR
    conveyors : ARRAY[1..3] OF FB_ConveyorProperties;
    i : DINT;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[FOR i := LOWER_BOUND(conveyors, 1) TO UPPER_BOUND(conveyors, 1) DO
    IF GVL_Line.applySpeed[i] THEN
        conveyors[i].SpeedSetpoint := GVL_Line.speedCommand[i];
    END_IF;
    IF GVL_Line.start[i] THEN
        conveyors[i].Start(delay := GVL_Line.startDelay[i]);
    END_IF;
    GVL_Line.updateCount[i] := conveyors[i].Update(
        guardClosed := GVL_Line.guardClosed[i],
        stopRequested := GVL_Line.stop[i],
        sensor := GVL_Line.productSensor[i]);
    GVL_Line.running[i] := conveyors[i].Running;
    GVL_Line.actualSpeed[i] := conveyors[i].ActiveSpeed;
    GVL_Line.productCount[i] := conveyors[i].ProductCount;
    GVL_Line.alarm[i] := conveyors[i].Alarm;
END_FOR;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
