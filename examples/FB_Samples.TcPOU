<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Samples">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Samples
VAR_INPUT
    index : INT := 1;
    value : REAL;
    write : BOOL;
END_VAR
VAR_OUTPUT
    values : ARRAY[1..3] OF REAL := [3(0.0)];
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[IF write THEN
    values[index] := value;
END_IF;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
