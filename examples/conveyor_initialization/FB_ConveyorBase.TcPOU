<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="FB_ConveyorBase">
    <Declaration><![CDATA[{attribute 'call_after_init'}
FUNCTION_BLOCK FB_ConveyorBase
VAR_INPUT
    enable : BOOL := TRUE;
    StartDelay : TIME := T#100ms;
END_VAR
VAR_OUTPUT
    id : DINT;
    running : BOOL;
    actualSpeed : LREAL;
    ready : BOOL;
    initTrace : DINT;
    baseInitCount : DINT;
    afterInitCount : DINT;
END_VAR
VAR
    config : REFERENCE TO ST_ConveyorConfig;
    startTimer : TON;
    factor : LREAL;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[startTimer(IN := ready AND enable AND_THEN config.enabled, PT := StartDelay);
running := startTimer.Q;
IF running THEN
    actualSpeed := config.speed * factor;
ELSE
    actualSpeed := 0.0;
END_IF;
]]></ST></Implementation>
    <Method Name="FB_init">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
    conveyorId : DINT;
    sharedConfig : REFERENCE TO ST_ConveyorConfig;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[id := conveyorId;
config REF= sharedConfig;
baseInitCount := baseInitCount + 1;
initTrace := initTrace * 10 + 1;
FB_init := TRUE;
]]></ST></Implementation>
    </Method>
    <Property Name="SpeedFactor">
      <Declaration><![CDATA[PROPERTY PUBLIC SpeedFactor : LREAL
]]></Declaration>
      <Get Name="Get">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[SpeedFactor := factor;
]]></ST></Implementation>
      </Get>
      <Set Name="Set">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[factor := SpeedFactor;
(* Instrumentation of this example's setup order. *)
initTrace := initTrace * 10 + 3;
]]></ST></Implementation>
      </Set>
    </Property>
    <Method Name="AfterInit">
      <Declaration><![CDATA[{attribute 'call_after_init'}
METHOD PUBLIC AfterInit
]]></Declaration>
      <Implementation><ST><![CDATA[afterInitCount := afterInitCount + 1;
initTrace := initTrace * 10 + 4;
]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
