<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="FB_MotorFake">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorFake IMPLEMENTS I_Motor
VAR_INPUT
    fault : BOOL;
END_VAR
VAR_OUTPUT
    updates : UDINT;
END_VAR
VAR
    speed : LREAL := 0.5;
    runningState : BOOL;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[(* Update is called through I_Motor by the conveyor. *)
]]></ST></Implementation>
    <Method Name="Update">
      <Declaration><![CDATA[METHOD PUBLIC Update
VAR_INPUT
    run : BOOL;
    delay : TIME;
END_VAR
VAR_INST
    startup : TON;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[updates := updates + 1;
startup(IN := run AND NOT fault, PT := delay);
THIS^.runningState := startup.Q;
]]></ST></Implementation>
    </Method>
    <Property Name="SpeedSetpoint">
      <Declaration><![CDATA[PROPERTY PUBLIC SpeedSetpoint : LREAL
]]></Declaration>
      <Get Name="Get">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[SpeedSetpoint := THIS^.speed;
]]></ST></Implementation>
      </Get>
      <Set Name="Set">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[THIS^.speed := LIMIT(0.0, SpeedSetpoint, 1.0);
]]></ST></Implementation>
      </Set>
    </Property>
    <Property Name="Running">
      <Declaration><![CDATA[PROPERTY PUBLIC Running : BOOL
]]></Declaration>
      <Get Name="Get">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[Running := THIS^.runningState;
]]></ST></Implementation>
      </Get>
    </Property>
    <Property Name="Faulted">
      <Declaration><![CDATA[PROPERTY PUBLIC Faulted : BOOL
]]></Declaration>
      <Get Name="Get">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[Faulted := fault;
]]></ST></Implementation>
      </Get>
    </Property>
    <Property Name="ActualSpeed">
      <Declaration><![CDATA[PROPERTY PUBLIC ActualSpeed : LREAL
]]></Declaration>
      <Get Name="Get">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation><ST><![CDATA[IF THIS^.runningState THEN
    ActualSpeed := THIS^.speed;
ELSE
    ActualSpeed := 0.0;
END_IF;
]]></ST></Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
