<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <GVL Name="GVL_Line">
    <Declaration><![CDATA[
{attribute 'qualified_only'}
VAR_GLOBAL
    start : ARRAY[1..3] OF BOOL;
    stop : ARRAY[1..3] OF BOOL;
    guardClosed : ARRAY[1..3] OF BOOL := [3(TRUE)];
    productSensor : ARRAY[1..3] OF BOOL;
    resetCount : ARRAY[1..3] OF BOOL;
    motorRunning : ARRAY[1..3] OF BOOL;
    productCount : ARRAY[1..3] OF UDINT;
    alarm : ARRAY[1..3] OF STRING(80);
    totalCount : UDINT;
END_VAR
VAR_GLOBAL CONSTANT
    startDelay : ARRAY[1..3] OF TIME := [T#100ms, T#250ms, T#500ms];
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
