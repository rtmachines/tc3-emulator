<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="FB_Line">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Line
VAR
    devices : ARRAY[1..3] OF I_Conveyor;
    i : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FOR i := LOWER_BOUND(devices, 1) TO UPPER_BOUND(devices, 1) DO
    IF devices[i] <> 0 THEN
        devices[i].Cycle(enabled := GVL_Line.enabled[i], sensor := GVL_Line.sensor[i], blocked := GVL_Line.blocked[i]);
        GVL_Line.running[i] := devices[i].Running;
        GVL_Line.actualSpeed[i] := devices[i].ActualSpeed;
        GVL_Line.productCount[i] := devices[i].ProductCount;
        GVL_Line.alarm[i] := devices[i].Alarm;
    ELSE
        GVL_Line.running[i] := FALSE;
        GVL_Line.actualSpeed[i] := 0.0;
        GVL_Line.productCount[i] := 0;
        GVL_Line.alarm[i] := 'Not bound';
    END_IF;
END_FOR;]]></ST>
    </Implementation>
    <Method Name="FB_init">
      <Declaration><![CDATA[METHOD PUBLIC FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
    first : I_Conveyor;
    second : I_Conveyor;
    third : I_Conveyor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[devices[1] := first;
devices[2] := second;
devices[3] := third;
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Bind">
      <Declaration><![CDATA[METHOD PUBLIC Bind
VAR_INPUT
    index : DINT;
    target : I_Conveyor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[devices[index] := target;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start">
      <Declaration><![CDATA[METHOD PUBLIC Start]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(devices, 1) TO UPPER_BOUND(devices, 1) DO
    IF devices[i] <> 0 THEN devices[i].Start(); END_IF;
END_FOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop">
      <Declaration><![CDATA[METHOD PUBLIC Stop]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(devices, 1) TO UPPER_BOUND(devices, 1) DO
    IF devices[i] <> 0 THEN devices[i].Stop(); END_IF;
END_FOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset">
      <Declaration><![CDATA[METHOD PUBLIC Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(devices, 1) TO UPPER_BOUND(devices, 1) DO
    IF devices[i] <> 0 THEN devices[i].Reset(); END_IF;
END_FOR;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
