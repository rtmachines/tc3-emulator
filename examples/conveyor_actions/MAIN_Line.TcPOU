<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1">
  <POU Name="MAIN_Line">
    <Declaration><![CDATA[PROGRAM MAIN_Line
VAR
    (* Constructors run base to derived; post-init setters precede AfterInit.
       Expected initTrace for each element before the first scan: 12345.
       Handwritten native-format sources; not exported or executed on TwinCAT. *)
    conveyors : ARRAY[1..3] OF FB_Conveyor[
        (conveyorId := 1, sharedConfig := GVL_Line.config, defaultDelay := T#1s),
        (conveyorId := 2, sharedConfig := GVL_Line.config, defaultDelay := T#1s),
        (conveyorId := 3, sharedConfig := GVL_Line.config, defaultDelay := T#1s)]
        := [(StartDelay := T#100ms, SpeedFactor := 1.0),
            (StartDelay := T#250ms, SpeedFactor := 1.0),
            (StartDelay := T#500ms, SpeedFactor := 1.0)];
    i : DINT;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[ReadInputs();
ControlConveyors();
WriteOutputs();
]]></ST></Implementation>
    <Action Name="ReadInputs" Id="{f9485bb6-a35c-40a1-901a-e76782ae055f}">
      <Implementation><ST><![CDATA[FOR i := LOWER_BOUND(conveyors, 1) TO UPPER_BOUND(conveyors, 1) DO
    conveyors[i].start := GVL_Line.start[i];
    conveyors[i].reset := GVL_Line.reset[i];
    conveyors[i].blocked := GVL_Line.blocked[i];
END_FOR;
]]></ST></Implementation>
    </Action>
    <Action Name="ControlConveyors" Id="{188a1356-695b-4ad4-a1fc-8286095ee08b}">
      <Implementation><ST><![CDATA[FOR i := LOWER_BOUND(conveyors, 1) TO UPPER_BOUND(conveyors, 1) DO
    conveyors[i]();
END_FOR;
]]></ST></Implementation>
    </Action>
    <Action Name="WriteOutputs" Id="{fac200ca-1bad-4382-bb80-0cd40cdddfae}">
      <Implementation><ST><![CDATA[FOR i := LOWER_BOUND(conveyors, 1) TO UPPER_BOUND(conveyors, 1) DO
    GVL_Line.state[i] := conveyors[i].state;
    GVL_Line.running[i] := conveyors[i].running;
    GVL_Line.actualSpeed[i] := conveyors[i].actualSpeed;
    GVL_Line.alarm[i] := conveyors[i].alarm;
END_FOR;
]]></ST></Implementation>
    </Action>
  </POU>
</TcPlcObject>
